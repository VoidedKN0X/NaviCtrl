    <string name="notifications">Benachrichtigungen</string>
    <string name="notifications_allowed">Erlaubt</string>
    <string name="notifications_allowed_summary">NaviCtrl kann die Musiksteuerung in der Benachrichtigung und auf dem Sperrbildschirm anzeigen. Tippe, um das in den Android-Einstellungen zu ändern.</string>
    <string name="notifications_are_blocked">Benachrichtigungen sind blockiert</string>
    <string name="notifications_are_blocked_summary">Android lässt NaviCtrl keine Benachrichtigungen anzeigen, daher bleibt die Musiksteuerung in der Benachrichtigung und auf dem Sperrbildschirm verborgen. Tippe auf Erlauben, um sie zu aktivieren.</string>
    <string name="notifications_footer">Die Musiksteuerung erscheint in einer Benachrichtigung. Android zeigt sie erst, wenn du Benachrichtigungen für NaviCtrl erlaubst.</string>
    <string name="allow">Erlauben</string>
    <string name="playback">Wiedergabe</string>
    <string name="playback_footer">ReplayGain nutzt die Lautheitswerte, die dein Server aus den Musikdateien liest (OpenSubsonic). Songs ohne diese Werte werden unverändert abgespielt.</string>
    <string name="gapless">Lückenlose Wiedergabe</string>
    <string name="gapless_subtitle">Lädt den nächsten Song vorab, damit er ohne Pause folgt. Überblenden entfällt zwischen Songs, die auf demselben Album ineinander übergehen.</string>
    <string name="crossfade">Überblenden</string>
    <plurals name="x_seconds">
        <item quantity="one">%1$d Sekunde</item>
        <item quantity="other">%1$d Sekunden</item>
    </plurals>
    <string name="replaygain">ReplayGain</string>
    <string name="replaygain_track">Titel: jeder Song gleich laut</string>
    <string name="replaygain_album">Album: behält die Lautstärkeunterschiede innerhalb eines Albums</string>
    <string name="replaygain_preamp">Vorverstärkung</string>
    <string name="x_db">%1$s dB</string>
    <string name="replaygain_clipping">Clipping verhindern</string>
    <string name="replaygain_clipping_subtitle">Hebt einen Song nie so weit an, dass seine lauteste Stelle verzerrt</string>
    <string name="equalizer">Equalizer</string>
    <string name="eq_on">An</string>
    <string name="eq_use">Equalizer verwenden</string>
    <string name="eq_use_subtitle">Änderungen sind sofort hörbar, auch über Bluetooth und im Auto</string>
    <string name="eq_footer">Equalizer und Bassverstärkung gehören zum Handy, daher hängen Voreinstellungen und Bänder von deinem Handy ab.</string>
    <string name="eq_presets">Voreinstellungen</string>
    <string name="eq_custom">Benutzerdefiniert</string>
    <string name="eq_bands">Bänder</string>
    <string name="eq_unavailable">Kein Equalizer auf diesem Handy</string>
    <string name="eq_unavailable_body">Android bietet auf diesem Handy keinen Equalizer, den NaviCtrl nutzen kann.</string>
    <string name="bass_boost">Bassverstärkung</string>
    <string name="bass_boost_strength">Stärke</string>
    <string name="bass_boost_footer">Nur, wenn der Equalizer an ist.</string>
    <string name="queue_sync_group">Andere Geräte</string>
    <string name="queue_sync">Warteschlange synchronisieren</string>
    <string name="queue_sync_subtitle">Speichert deine Warteschlange, den Song und die Position auf deinem Server und bietet an, eine von einem anderen Gerät gespeicherte Warteschlange fortzusetzen</string>
    <string name="queue_sync_footer">Nutzt die gespeicherte Warteschlange deines Servers, dieselbe wie andere Subsonic-Apps und -Geräte. Sie liegt nur auf deinem eigenen Server.</string>
    <string name="queue_sync_resume">Von einem anderen Gerät fortsetzen</string>
    <string name="queue_sync_resume_subtitle">Jetzt nach der auf deinem Server gespeicherten Warteschlange suchen</string>
    <string name="queue_sync_nothing">Keine andere Warteschlange auf deinem Server</string>
    <string name="queue_sync_offer_title">Von einem anderen Gerät fortsetzen?</string>
    <string name="queue_sync_offer_at">Bei %1$s</string>
    <string name="queue_sync_offer_from">Gespeichert von %1$s</string>
    <string name="queue_sync_offer_from_when">Gespeichert von %1$s am %2$s</string>
    <string name="queue_sync_unknown_app">einer anderen App</string>
    <string name="queue_sync_continue">Hier fortsetzen</string>
    <string name="queue_sync_keep">Diese Warteschlange behalten</string>
    <string name="music_on_this_phone">Musik auf diesem Handy</string>
    <string name="no_server_label">KEIN SERVER?</string>
    <string name="use_music_on_this_phone">Musik auf diesem Handy verwenden</string>
    <string name="music_on_this_phone_sub">Spielt die auf diesem Handy gespeicherten Songs, mit Favoriten, Playlists und Suche, ohne Navidrome-Server. Einen Server kannst du später in den Einstellungen hinzufügen.</string>
    <string name="music_permission_denied">NaviCtrl braucht die Berechtigung „Musik und Audio“, um die Songs auf diesem Handy abzuspielen. Tippe erneut auf die Taste, um die Berechtigungen zu öffnen.</string>
    <string name="lyrics_from_server">VON DEINEM SERVER</string>
    <string name="lyrics_from_lrclib">VON LRCLIB.NET</string>
    <string name="lyrics_search_again">Erneut suchen</string>
    <string name="lyrics_instrumental">Instrumental</string>
    <string name="lyrics_instrumental_body">Laut LRCLIB hat dieser Song keinen Text.</string>
    <string name="lyrics_none_online">Weder dein Server noch LRCLIB hat einen Songtext für diesen Song. NaviCtrl sucht in einer Woche erneut, oder tippe auf Erneut suchen.</string>
    <string name="lyrics_jump_here">Ab dieser Zeile abspielen</string>
    <string name="lyrics_online">Songtexte online suchen (LRCLIB)</string>
    <string name="lyrics_online_subtitle">Wenn dein Server keinen Songtext hat, auf lrclib.net suchen</string>
    <string name="lyrics_online_footer">Nur Titel, Künstler, Album und Länge des Songs werden an lrclib.net gesendet, eine freie, offene Songtext-Datenbank. Nichts über dich oder deinen Server. Songtexte bleiben auf dem Handy, daher wird jeder Song nur einmal gesucht. Nie für Musik auf diesem Handy verwendet.</string>
    <string name="downloads_settings_footer">Downloads, die ihre Verbindung verlieren, laufen dort weiter, wo sie aufgehört haben, sobald das Handy wieder online ist.</string>
    <string name="download_format">Download-Format</string>
    <string name="download_limit">Speicher für Downloads</string>
    <string name="no_limit">Keine Begrenzung</string>
    <string name="download_limit_reached">Nicht genug Platz: Downloads dürfen %1$s nutzen (Einstellungen &gt; Downloads)</string>
    <string name="download_limit_used">%1$s von %2$s belegt</string>
    <string name="show_downloaded_only">Nur heruntergeladene Songs anzeigen</string>
    <string name="show_all_songs">Alle Songs anzeigen</string>
    <string name="unreadable_title">Deine gespeicherten Daten lassen sich nicht öffnen</string>
    <string name="unreadable_body">Die Liste deiner Downloads sowie die Favoriten und Playlists der Musik auf diesem Handy sind verschlüsselt auf diesem Handy gespeichert, und der Schlüssel dazu fehlt im sicheren Speicher des Handys oder passt nicht mehr. Nichts wurde gelöscht oder geändert. Versuche es zuerst erneut; auch ein Neustart des Handys kann helfen.</string>
    <string name="unreadable_download_blocked">Deine Downloadliste lässt sich nicht öffnen, daher kann nichts Neues heruntergeladen werden. Öffne Downloads, um zu sehen, was du tun kannst.</string>
    <string name="unreadable_downloads_row">Lässt sich nicht öffnen: Tippe für den Grund</string>
    <string name="unreadable_retry">Erneut versuchen</string>
    <string name="unreadable_start_empty">Leer beginnen</string>
    <string name="unreadable_start_empty_title">Leer beginnen?</string>
    <string name="unreadable_start_empty_body">Mach das nur, wenn erneutes Versuchen nicht hilft. Was sich nicht öffnen lässt, wird auf diesem Handy beiseitegelegt, nicht gelöscht, aber NaviCtrl zeigt es nicht an: Die Downloadliste beginnt leer, und die Musik auf diesem Handy beginnt ohne Favoriten, Bewertungen, Wiedergabezahlen und Playlists. Heruntergeladene Songs bleiben auf dem Handy, ohne aufgelistet zu werden: Lade einen Song erneut herunter, um ihn wieder in der Liste zu haben, oder lösche den Speicher von NaviCtrl in den Android-Einstellungen, um den Platz freizugeben. Auf deinem Server ändert sich nichts.</string>
    <string name="share_link">Link teilen</string>
    <string name="share_links">Freigabelinks</string>
    <string name="share_links_subtitle">Öffentliche Links, die du zu Alben, Playlists und Songs erstellt hast</string>
    <string name="share_making">Link wird erstellt…</string>
    <string name="share_failed">Der Server hat keinen Link zurückgegeben</string>
    <string name="share_off_on_server">Teilen ist auf deinem Server ausgeschaltet. Aktiviere EnableSharing in den Navidrome-Einstellungen, um Freigabelinks zu nutzen.</string>
    <string name="share_none">Keine Freigabelinks</string>
    <string name="share_none_body">Wähle „Link teilen“ im Menü eines Songs, Albums oder einer Playlist. Jeder mit dem Link kann im Browser hören, ohne Konto.</string>
    <string name="share_send">Erneut teilen</string>
    <string name="share_copy">Link kopieren</string>
    <string name="share_delete">Link löschen</string>
    <string name="share_delete_title">Diesen Link löschen?</string>
    <string name="share_delete_body">Der Link zu %1$s funktioniert für alle, die ihn haben, nicht mehr. Das kann nicht rückgängig gemacht werden. Deine Musik bleibt, wo sie ist.</string>
    <string name="share_deleted">Link gelöscht</string>
    <string name="share_no_expiry">Kein Enddatum</string>
    <string name="share_expires_x">Bis %1$s</string>
    <string name="share_expired_x">Beendet am %1$s</string>
