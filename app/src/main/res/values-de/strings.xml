        <item quantity="other">%1$d Aufrufe</item>
    </plurals>
    <string name="preload_mobile">Nächsten Song bei mobilen Daten vorladen</string>
    <string name="preload_mobile_subtitle">Während ein Song über mobile Daten läuft, wird der ganze nächste Song geladen und auf dem Handy behalten, damit die Musik bei Funklöchern weiterläuft. Verbraucht mobile Daten für Songs, die du vielleicht überspringst.</string>
    <string name="preload_mobile_needs_cache">Braucht „Gespielte Musik auf dem Handy behalten“: Wähle oben eine Größe und starte NaviCtrl neu</string>
    <string name="peq">Parametrischer Equalizer</string>
    <string name="peq_use">Parametrischen Equalizer verwenden</string>
    <string name="peq_use_subtitle">Eigene Bänder, jedes mit eigener Frequenz, Verstärkung und Breite</string>
    <string name="peq_footer">Die eigenen Filter von NaviCtrl im Player, daher funktionieren sie auf jedem Handy und an jedem Ausgang gleich. Bis zu 10 Bänder. Kann zusammen mit dem Equalizer des Handys oben genutzt werden.</string>
    <string name="peq_preamp">Vorverstärkung</string>
    <string name="peq_clip_warning">Die Kurve liegt %1$s dB über 0. Laute Stellen können verzerren: Senke die Vorverstärkung um so viel.</string>
    <string name="peq_add_band">Band hinzufügen</string>
