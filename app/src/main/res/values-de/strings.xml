    <string name="peq_type_low_shelf">Low Shelf</string>
    <string name="peq_type_high_shelf">High Shelf</string>
    <string name="peq_frequency">Frequenz</string>
    <string name="peq_gain">Verstärkung</string>
    <string name="peq_width">Breite</string>
    <string name="peq_width_hint">Ein höheres Q ist schmaler. Bei einem Shelf bestimmt Q, wie steil die Stufe ist (0,71 ist üblich).</string>
    <string name="peq_remove_band">Dieses Band entfernen</string>
    <string name="backup_title">Exportieren und importieren</string>
    <string name="backup_footer">Die Datei enthält die Einstellungen von NaviCtrl: Qualität, Downloads, Wiedergabe, beide Equalizer, Songtexte, Hörverlauf, Aussehen und Sortierung. Sie enthält keine Konten, Serveradressen oder Passwörter und nichts von App-Sperre, Erneut sperren, In Screenshots ausblenden oder In letzten Apps ausblenden: Ein Import lässt diese unverändert.</string>
    <string name="backup_save">Einstellungen exportieren</string>
    <string name="backup_save_sub">Als Datei speichern, etwa in Downloads oder einem Cloud-Ordner</string>
    <string name="backup_restore">Einstellungen importieren</string>
    <string name="backup_restore_sub">Eine früher gespeicherte Einstellungsdatei laden</string>
    <string name="backup_saved">Einstellungen gespeichert</string>
    <string name="backup_save_failed">Datei konnte nicht gespeichert werden</string>
    <string name="backup_read_failed">Datei konnte nicht gelesen werden</string>
    <string name="backup_not_valid">Das ist keine NaviCtrl-Einstellungsdatei</string>
    <string name="backup_too_new">Diese Datei stammt von einer neueren NaviCtrl-Version. Aktualisiere zuerst die App.</string>
    <string name="backup_restore_title">Diese Einstellungen importieren?</string>
    <string name="backup_restore_body">Am %1$s mit NaviCtrl %2$s gespeicherte Einstellungen ersetzen die hiesigen: Streaming- und Download-Qualität, Größe des Caches für gespielte Musik, Wiedergabe (lückenlos, Überblenden, ReplayGain), beide Equalizer mit ihren Bändern, Songtext-Suche, Hörverlauf, Warteschlangen-Sync, Design und Sortierung.\n\nDeine Konten, Passwörter, Downloads, die App-Sperre und die Datenschutzschalter sind nicht in der Datei und bleiben unverändert. Eine andere Cachegröße gilt nach einem Neustart.</string>
    <string name="backup_restore_confirm">Importieren</string>
    <string name="backup_restored">Einstellungen importiert</string>
    <string name="backup_restore_failed">Einstellungen konnten nicht importiert werden</string>
