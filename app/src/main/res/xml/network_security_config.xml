<?xml version="1.0" encoding="utf-8"?>
<!-- The server address is typed by the user, so cleartext can't be limited to a fixed domain here.
     Plain HTTP stays possible at the platform level because many Navidrome servers run on a home
     network, but the app enforces it in code (CleartextPolicy): HTTP is only used for a server the
     user explicitly chose after an "unencrypted" warning.
     User-installed CAs are trusted so servers behind a private CA / reverse proxy work. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <!-- LRCLIB (lyrics found online) is a fixed public host: https only, and only the phone's built-in
         CAs, so a user-installed CA can't read or change lyric lookups. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">lrclib.net</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
